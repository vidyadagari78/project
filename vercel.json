{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.3"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/about",
      "dest": "/about.php"
    },
    {
      "src": "/practice-areas",
      "dest": "/practice-areas.php"
    },
    {
      "src": "/team",
      "dest": "/team.php"
    },
    {
      "src": "/courts",
      "dest": "/courts.php"
    },
    {
      "src": "/contact",
      "dest": "/contact.php"
    },
    {
      "src": "/disclaimer",
      "dest": "/disclaimer.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
